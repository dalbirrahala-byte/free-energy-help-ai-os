+import postgres from 'postgres';
+import { isIP } from 'node:net';
+import { createReservedOpener } from '../../../../docs/review/website-enquiry-intake/source/reserved-session.mjs';
+import { createWebsitePost } from './createWebsitePost.ts';
+
+// Supplied only by a separately reviewed server binding. The route defaults to null.
+interface WebsiteDatabaseConfig {
+  hostname: string;
+  port: number;
+  database: string;
+  writer: string;
+  password: () => Promise<string>;
+  key: string;
+}
+
+function validHostname(value: string) {
+  return typeof value === 'string' && value.length <= 253 && !isIP(value) &&
+    value.split('.').every(label => /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/i.test(label));
+}
+
+export function createPostgresWebsitePost(config: WebsiteDatabaseConfig | null) {
+  if (!config || !validHostname(config.hostname) || !Number.isInteger(config.port) ||
+      config.port < 1 || config.port > 65535 || !config.database?.trim() ||
+      !config.writer?.trim() || typeof config.password !== 'function' ||
+      typeof config.key !== 'string' || config.key.length < 32) {
+    return createWebsitePost(null);
+  }
+
+  const {hostname, port, database, writer, password, key} = config;
+  const openFresh = createReservedOpener(() => postgres({
+    host: hostname, port, database, user: writer, password,
+    ssl: {servername: hostname, rejectUnauthorized: true},
+    connection: {search_path: 'pg_catalog'},
+    max: 1, prepare: false, fetch_types: false, connect_timeout: 5,
+    debug: false, onnotice: false,
+  }), async (session: postgres.ReservedSql) => {
+    const [row] = await session`
+      select current_database()::text = ${database} and session_user::text = ${writer}
+        and current_user = session_user and not pg_is_in_recovery()
+        and current_setting('transaction_read_only') = 'off'
+        and current_setting('fsync') = 'on' and current_setting('full_page_writes') = 'on'
+        and current_setting('synchronous_commit') = 'on'
+        and (select count(*) = 3 from pg_class c join pg_namespace n on n.oid = c.relnamespace
+             where n.nspname = 'public' and c.relkind = 'r' and c.relpersistence = 'p'
+               and c.relname in ('leads','website_enquiry_receipts','audit_log'))
+        and has_schema_privilege('public','usage')
+        and has_function_privilege('public.ingest_website_enquiry(jsonb)','execute')
+        and not exists (
+          select 1 from pg_proc p join pg_namespace n on n.oid = p.pronamespace
+          where n.nspname <> 'information_schema' and n.nspname !~ '^pg_'
+            and p.prosecdef and p.prokind in ('f','p')
+            and p.oid <> 'public.ingest_website_enquiry(jsonb)'::regprocedure
+            and has_schema_privilege(n.oid,'usage') and has_function_privilege(p.oid,'execute'))
+        and not exists (
+          select 1 from (values ('public.leads'),('public.website_enquiry_receipts'),('public.audit_log')) t(name)
+          where has_table_privilege(t.name,'select,insert,update,delete,truncate,references,trigger')
+             or has_any_column_privilege(t.name,'select,insert,update,references'))
+        as eligible`;
+    return row?.eligible === true;
+  });
+
+  return createWebsitePost({key, now: Date.now, openFresh});
+}
