diff --git a/frontend/src/lib/website-enquiries/createWebsitePost.ts b/frontend/src/lib/website-enquiries/createWebsitePost.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/lib/website-enquiries/createWebsitePost.ts
@@ -0,0 +1,18 @@
+import {createReceiver} from '../../../../docs/review/website-enquiry-intake/source/receiver.ts';
+import {createCommittedPostgresStore} from '../../../../docs/review/website-enquiry-intake/source/committed-postgres-store.ts';
+import type {OwnedPostgresConnection} from '../../../../docs/review/website-enquiry-intake/source/committed-postgres-store.ts';
+
+interface WebsiteReceiverConfig {
+  key: string;
+  now: () => number;
+  openFresh: () => Promise<OwnedPostgresConnection>;
+}
+
+export function createWebsitePost(config: WebsiteReceiverConfig | null) {
+  if (!config) return createReceiver(null);
+  return createReceiver({
+    key: config.key,
+    now: config.now,
+    save: createCommittedPostgresStore(config.openFresh),
+  });
+}
